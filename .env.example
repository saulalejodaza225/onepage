# Copia este archivo a .env y llena los valores del Dashboard de Wompi (Desarrolladores).
# .env nunca debe subirse al repositorio.

# sandbox para pruebas, production para cobrar de verdad
WOMPI_ENV=sandbox
WOMPI_PUBLIC_KEY=pub_test_xxxxxxxxxxxxxxxx
WOMPI_INTEGRITY_SECRET=test_integrity_xxxxxxxxxxxxxxxx
WOMPI_EVENTS_SECRET=test_events_xxxxxxxxxxxxxxxx

# URL pública del sitio. En local no hace falta; en Vercel usa tu dominio, por ejemplo https://tu-sitio.vercel.app
PUBLIC_URL=

# Correo para enviar el paquete de bienvenida (Resend). Sin estas dos variables el paquete queda listo para envío manual.
RESEND_API_KEY=
EMAIL_FROM=Arquitectura digital <hola@tu-dominio.com>

# Datos del proveedor que aparecen en el contrato y la cuenta de cobro. Usa una sola línea JSON.
# Alternativa local: copia paquete/proveedor.ejemplo.json a paquete/proveedor.json y complétalo.
PROVEEDOR_JSON=
