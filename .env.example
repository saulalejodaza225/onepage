# Copia este archivo a .env y llena los valores. Nunca subas .env a git.
# Después revisa todo con: npm run verificar

# Modo de Wompi: sandbox (pruebas) o production (cobros reales)
WOMPI_ENV=sandbox

# Llaves y secretos del Dashboard de Wompi, del mismo modo que elegiste arriba
WOMPI_PUBLIC_KEY=pub_test_xxxxxxxxxxxxxxxx
WOMPI_INTEGRITY_SECRET=test_integrity_xxxxxxxxxxxxxxxx
WOMPI_EVENTS_SECRET=test_events_xxxxxxxxxxxxxxxx

# Opcional: solo si npm run verificar indica que Wompi pide autorización para consultar transacciones
WOMPI_PRIVATE_KEY=

# Dirección pública del sitio, sin barra final. En Vercel: https://onepage-navy.vercel.app
PUBLIC_URL=

# Correo del paquete de bienvenida (Resend). Sin estas dos variables, el paquete queda pendiente para envío manual.
RESEND_API_KEY=
EMAIL_FROM=Arquitectura digital <hola@tu-dominio.com>

# Datos del proveedor para el contrato y la cuenta de cobro: una sola línea JSON.
# Alternativa local: copia paquete/proveedor.ejemplo.json a paquete/proveedor.json y complétalo.
PROVEEDOR_JSON=
